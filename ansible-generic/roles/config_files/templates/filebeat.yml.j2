# =============================================================================
# Filebeat Configuration — Managed by Ansible
# =============================================================================
# Do not edit manually — changes will be overwritten on next deployment.
# Template: roles/config_files/templates/filebeat.yml.j2
# =============================================================================

# -----------------------------------------------------------------------------
# Inputs
# -----------------------------------------------------------------------------
filebeat.inputs:
{% if ansible_os_family != 'Windows' %}
  # Linux log files
  - type: filestream
    id: system-logs
    enabled: true
    paths:
      - /var/log/messages
      - /var/log/secure
      - /var/log/auth.log
      - /var/log/syslog
      - /var/log/*.log
    exclude_files:
      - '\.gz$'
      - '\.bz2$'
      - '\.zip$'
{% endif %}

{% if ansible_os_family == 'Windows' %}
# Windows Event Logs
filebeat.modules:
  - module: system
    syslog:
      enabled: false
    auth:
      enabled: false

winlogbeat.event_logs:
  - name: Application
    ignore_older: 72h
  - name: Security
    ignore_older: 72h
  - name: System
    ignore_older: 72h
{% endif %}

# -----------------------------------------------------------------------------
# Processors — enrich events with host metadata
# -----------------------------------------------------------------------------
processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded
  - add_cloud_metadata: ~

# -----------------------------------------------------------------------------
# Output — Elasticsearch
# -----------------------------------------------------------------------------
output.elasticsearch:
  hosts:
{% for host in filebeat_elasticsearch_hosts %}
    - "{{ host }}"
{% endfor %}
  protocol: "{{ filebeat_elasticsearch_protocol | default('https') }}"
  ssl.verification_mode: none
{% if filebeat_elasticsearch_username is defined %}
  username: "{{ filebeat_elasticsearch_username }}"
  password: "{{ filebeat_elasticsearch_password }}"
{% endif %}

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
setup.template.settings:
  index.number_of_shards: 1

setup.kibana:
  host: "{{ filebeat_kibana_host | default(filebeat_elasticsearch_hosts[0]) }}"

# Logging
logging.level: info
logging.to_files: true
logging.files:
{% if ansible_os_family != 'Windows' %}
  path: /var/log/filebeat
{% else %}
  path: C:/Program Files/Filebeat/logs
{% endif %}
  name: filebeat
  keepfiles: 7
  permissions: 0644
